# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# Server-side only (never expose in client code)
# Get from: https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_SECRET_KEY=

# Cardano merchant identity (backend signer)
CARDANO_MERCHANT_SKEY=
MERCHANT_ADDRESS=
VITE_MERCHANT_ADDRESS=      # Same as MERCHANT_ADDRESS, exposed to browser

# TX3 / Cardano network
TX3_TRP_ENDPOINT=           # TRP server URL (dolos local or preview TRP)
TX3_TRP_API_KEY=            # dmtr-api-key header value (required for preview)
TX3_PROFILE=                # "local" | "preview"
VITE_TX3_PROFILE=           # Same as TX3_PROFILE, exposed to browser

# Escrow timeouts (seconds) — used by lock-payment and release scripts
ESCROW_SHIP_DEADLINE_SECONDS=60
ESCROW_GRACE_PERIOD_SECONDS=60

# Escrow reference script UTxO — created once per environment by submitting a
# tx that carries the validator CBOR in its `reference_script` slot. Required
# by mark_shipped / release_escrow / refund_escrow so the TRP resolver can
# attach the script. Re-publish whenever the validator (aiken build --env <X>)
# produces a new hash.
ESCROW_SCRIPT_REF_TX_HASH=
ESCROW_SCRIPT_REF_OUTPUT_INDEX=

# Optional
# METADATA_LABEL=1337       # Numeric label for order-event metadata (default: 1337)